{
  "name": "skillforge-ai",
  "version": "1.1.0",
  "description": "Autonomous SDLC Engineering Platform for AI Coding Agents",
  "type": "module",
  "bin": {
    "skillforge": "./bin/skillforge.mjs"
  },
  "scripts": {
    "skillforge": "node bin/skillforge.mjs",
    "gate": "node bin/skillforge.mjs gate",
    "diff": "node bin/skillforge.mjs diff",
    "graph": "node bin/skillforge.mjs graph",
    "slice": "node bin/skillforge.mjs slice",
    "scaffold": "node bin/skillforge.mjs scaffold",
    "signoff": "node bin/skillforge.mjs signoff",
    "heal": "node bin/skillforge.mjs heal",
    "sync": "node bin/skillforge.mjs sync",
    "mcp": "node bin/skillforge.mjs mcp",
    "pr:scorecard": "node scripts/generate-pr-scorecard.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"bin/**/*.mjs\" \"tests/**/*.ts\" \"examples/order-service/**/*.ts\" \"*.json\" \"eslint.config.mjs\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"bin/**/*.mjs\" \"tests/**/*.ts\" \"examples/order-service/**/*.ts\" \"*.json\" \"eslint.config.mjs\" \"tsconfig*.json\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.checkjs.json",
    "test:ts": "node --experimental-strip-types --test \"tests/**/*.spec.ts\" \"examples/order-service/tests/**/*.spec.ts\"",
    "test:dotnet": "dotnet run --project examples/dotnet-order-service/tests/OrderService.Tests/OrderService.Tests.csproj",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 85 --branches 70 node --experimental-strip-types --test \"tests/**/*.spec.ts\" \"examples/order-service/tests/**/*.spec.ts\"",
    "test": "npm run test:ts && npm run test:dotnet"
  },
  "c8": {
    "extension": [
      ".js",
      ".mjs",
      ".ts"
    ],
    "exclude": [
      "coverage/**",
      "tests/**",
      "examples/dotnet-order-service/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "ai",
    "agents",
    "sdlc",
    "coding-agents",
    "clean-architecture",
    "quality-gates",
    "mcp",
    "dotnet",
    "typescript"
  ],
  "author": "SkillForgeAI",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0"
  }
}
